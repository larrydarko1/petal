{
    "name": "petal",
    "version": "1.0.4",
    "description": "A lightweight notepad that does simple things — open, edit, and save plain text files. That's it.",
    "keywords": [
        "notepad",
        "text-editor",
        "tauri",
        "desktop",
        "vue"
    ],
    "homepage": "https://github.com/larrydarko1/Petal#readme",
    "bugs": {
        "url": "https://github.com/larrydarko1/Petal/issues"
    },
    "license": "MIT",
    "author": "Lorenzo Mazzola",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/larrydarko1/Petal.git"
    },
    "scripts": {
        "dev": "tauri dev",
        "vite:dev": "vite",
        "typecheck": "vue-tsc -b tsconfig.json",
        "build": "npm run typecheck && vite build",
        "tauri:build": "tauri build",
        "tauri:build:mac:universal": "tauri build --target universal-apple-darwin",
        "tauri:build:mac:arm": "tauri build --target aarch64-apple-darwin",
        "tauri:build:mac:intel": "tauri build --target x86_64-apple-darwin",
        "tauri:build:linux": "tauri build",
        "tauri:build:win": "tauri build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{ts,js,vue,scss,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,js,vue,scss,json,md}\"",
        "stylelint": "stylelint \"src/**/*.{scss,vue}\"",
        "stylelint:fix": "stylelint \"src/**/*.{scss,vue}\" --fix",
        "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
        "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
        "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "preview": "vite preview",
        "tauri": "tauri",
        "icons:generate": "tauri icon src/assets/icon.svg",
        "prepare": "husky",
        "ci:check": "npm run lint && npm run format:check && npm run stylelint && npm run typecheck && npm run test:coverage && npm run check && npm run rust:fmt && npm run rust:lint && npm run rust:test && vite build",
        "check": "larry check"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.12.4",
        "@tauri-apps/plugin-dialog": "^2.8.3",
        "@tauri-apps/plugin-fs": "^2.7.1",
        "@tauri-apps/plugin-log": "^2.10.1",
        "vue": "^3.5.44"
    },
    "devDependencies": {
        "@larrydarko/lint-config": "^0.1.0-beta.10",
        "@tauri-apps/cli": "^2.12.4",
        "@types/node": "^24.9.1",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^5.0.5",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "jsdom": "^30.1.3",
        "sass": "^1.106.1",
        "typescript": "~6.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "packageManager": "npm@11.16.0",
    "engines": {
        "node": ">=24",
        "npm": ">=11"
    },
    "private": true
}
