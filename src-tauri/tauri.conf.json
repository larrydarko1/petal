{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Petal",
    "version": "../package.json",
    "identifier": "dev.larrydarko.petal",
    "build": {
        "beforeDevCommand": "npm run vite:dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "",
                "width": 700,
                "height": 640
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "connect-src": "ipc: http://ipc.localhost",
                "img-src": "'self' asset: http://asset.localhost blob: data:"
            },
            "devCsp": {
                "default-src": "'self'",
                "connect-src": "ipc: http://ipc.localhost ws://localhost:1420",
                "img-src": "'self' asset: http://asset.localhost blob: data:",
                "style-src": "'self' 'unsafe-inline'"
            },
            "freezePrototype": true,
            "capabilities": ["main"]
        }
    },
    "bundle": {
        "active": true,
        "targets": ["deb", "rpm", "appimage"],
        "category": "Utility",
        "shortDescription": "A lightweight notepad",
        "publisher": "Lorenzo Mazzola",
        "homepage": "https://github.com/larrydarko1/Petal",
        "license": "MIT",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
        "fileAssociations": [
            {
                "ext": ["txt"],
                "mimeType": "text/plain",
                "description": "Text Document"
            }
        ]
    }
}
