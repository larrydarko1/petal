// A solution file: it checks nothing itself, so editors and ESLint find the right
// project for each file. `npm run typecheck` builds every reference.
{
    "files": [],
    "references": [
        { "path": "./tsconfig.app.json" },
        { "path": "./tsconfig.node.json" },
        { "path": "./tsconfig.test.json" },
        { "path": "./tsconfig.scripts.json" }
    ]
}
