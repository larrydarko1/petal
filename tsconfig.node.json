{
    // The tool configs at the root, which Vite, Vitest and larry load in Node, so they
    // get Node's types.
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        /* Output & Build */
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "noEmit": true,

        /* Target & Environment */
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2024"],

        /* Paths & Types */
        "types": ["node"],

        /* Module System */
        "moduleDetection": "force"
    },
    "include": ["vite.config.ts", "vitest.config.ts", "larry.config.ts"]
}
